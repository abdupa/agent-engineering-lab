NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Required at startup. Supply your key and a model supporting Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required at startup. Absolute path to the ONE directory an audit may read.
# The audit request carries no path: this is the only thing that decides what is
# readable, so point it at a codebase you are willing to have read in full.
AUDIT_ROOT=

# Optional. Cost is reported only when BOTH are set, because provider pricing changes
# and a hardcoded table would go stale silently. Leave unset to get tokens only.
# Values are price per one million tokens, in whatever currency you name below.
OPENAI_INPUT_COST_PER_MTOK=
OPENAI_OUTPUT_COST_PER_MTOK=
OPENAI_COST_CURRENCY=USD

# Optional. Set to 1 to request tool arguments as a typed object instead of an escaped
# JSON string. The string transport is the v0.3 default; the typed one removes the
# escaping failures seen on live runs 5 and 6. Verify the live API accepts the schema
# before relying on it.
AGENT_TYPED_ARGUMENTS=

# Optional. Total provider tokens one audit may spend. Checked between steps, so a run
# can overshoot by the single call that crossed the line. Unset means unbounded, which
# is what steps and wall time alone give you today.
AUDIT_MAX_TOKENS=
