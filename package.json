{
  "name": "agent-engineering-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-engineering-lab/api dev",
    "start": "pnpm --filter @agent-engineering-lab/api start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:openai": "pnpm --filter @agent-engineering-lab/api smoke:openai",
    "probe:agent": "pnpm --filter @agent-engineering-lab/api probe:agent",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && git diff --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  }
}
