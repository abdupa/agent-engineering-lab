# Run records are evidence. Reformatting one edits the record of what a paid run produced,
# and the pattern covers every release so a new one does not silently fall outside it.
docs/releases/*/runs/

# Evaluation targets are data, not source. Their defects are planted deliberately and their
# exact bytes are recorded in the answer key, so reformatting one silently invalidates the
# key that makes it scoreable.
docs/eval/targets/

# Scorecards are written by scripts/score-runs.ts. Reformatting one would make the file on
# disk differ from what the script produces, and the baseline gate compares them.
docs/eval/scorecards/
